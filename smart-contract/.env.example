# Smart Contract Deployment Configuration

# Private key of deployer account (with MATIC for gas)
PRIVATE_KEY=0x...

# Backend wallet address (will receive MINTER_ROLE)
BACKEND_WALLET=0x...

# Verifier wallet address (will receive VERIFIER_ROLE) - optional
VERIFIER_WALLET=0x...

# Polygonscan API key for contract verification (optional)
POLYGONSCAN_API_KEY=...
