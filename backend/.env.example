# Blockchain Configuration
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=0x...
BACKEND_WALLET_KEY=0x...
CONTRACT_ABI_PATH=./artifacts/contracts/BlueCarbonCredit.sol/BlueCarbonCredit.json

# IPFS Configuration (Pinata)
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret

# Database Configuration
DATABASE_URL=sqlite:///./blue_veracity.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/blue_veracity

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
# For production, specify your actual domains:
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
